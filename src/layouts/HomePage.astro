---
// Import Config
import { siteConfig } from "../siteConfig";
// Import Assets
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
// Import Styles
import "../assets/css/styles.css";
// Import Components
import HomeHeader from "../components/layout/HomeHeader.astro";
import Footer from "../components/layout/Footer.astro";
import MobileNav from "../components/navigation/MobileNav.astro";
import RequestForm from "../components/sections/RequestForm.astro";

// Import Symbols > Icons
// const iconFiles = import.meta.glob("../icons/{Whistle,Skimmer,Swimmer,Umbrella,Cross,Hamburger,MobilePhone,ArrowLeft,ArrowRight,Mail,Logo}.astro", { eager: true });
const iconFiles = import.meta.glob("../icons/{Whistle,Skimmer,Swimmer,Umbrella,Cross,Hamburger,MobilePhone,ArrowLeft,ArrowRight,Mail,Logo}.astro", { eager: true });
const iconComponents = Object.values(iconFiles).map((module: any) => module.default);

// Import Symbols > Logos
const logoFiles = import.meta.glob("../assets/images/logo/*.astro", { eager: true });
const logoComponents = Object.values(logoFiles).map((module: any) => module.default);

// Import Symbols > HomeHero.astro
const badgeFiles = import.meta.glob("../assets/images/badges/*.astro", { eager: true });
const badgeComponents = Object.values(badgeFiles).map((module: any) => module.default);

// Imports Symbols > ServiceArea.astro
const brandFiles = import.meta.glob("../assets/images/brands/*.astro", { eager: true });
const brandComponents = Object.values(brandFiles).map((module: any) => module.default);

const svgSymbols = [
    ...iconComponents,
    ...logoComponents,
    ...badgeComponents,
    ...brandComponents
];

interface Props {
    title?: string;
    description?: string;
    keywords?: string;
    author?: string;
    ogImage?: string;
    favicon?: string;
}

const {
    title = siteConfig.title,
    description = siteConfig.description,
    keywords = siteConfig.keywords,
    author = siteConfig.author,
    ogImage = siteConfig.ogImage,
    favicon = "/favicon.svg",
} = Astro.props;
---
<!doctype html>
<html lang="en">
    <head>
        <!-- Preconnect Critical Third-Party Origins -->
        <link rel="preconnect" href="https://518512.tctm.co" crossorigin />
        <link rel="dns-prefetch" href="https://518512.tctm.co" />
        <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
        <link rel="preconnect" href="https://elfsightcdn.com" crossorigin />
        <!-- Google Tag Manager -->
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({'gtm.start': new Date().getTime(), event: 'gtm.js'});
          
          function loadGTM() {
            if (window.__gtm_loaded) return;
            window.__gtm_loaded = true;
            var j = document.createElement('script');
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-58ZZ7XB2';
            document.head.appendChild(j);
          }

          var gtmEvents = ['pointerdown', 'scroll', 'keydown', 'touchstart'];
          function triggerGTM() {
            loadGTM();
            gtmEvents.forEach(function(e) { window.removeEventListener(e, triggerGTM, {passive: true}); });
          }
          gtmEvents.forEach(function(e) { window.addEventListener(e, triggerGTM, {passive: true}); });
          setTimeout(loadGTM, 2500);
        </script>
        <!-- End Google Tag Manager -->
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="keywords" content={keywords} />
        <meta name="author" content={author} />
        <meta name="generator" content={Astro.generator} />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://www.qualitypoolandspa.com" />
        <link rel="canonical" href={Astro.url.href} />
        <title>{title}</title>
        <link rel="icon" href={favicon} type="image/x-icon" />
        <Font cssVariable="--font-raleway" preload />
        <Font cssVariable="--font-quicksand" />
        <Font cssVariable="--font-roboto-condensed" />
        <ClientRouter />
        <!-- GTM Client Router Pageview Tracking Hook -->
        <script>
            document.addEventListener("astro:page-load", () => {
                const globalWindow = window as any;
                
                // Track page view in GTM
                globalWindow.dataLayer = globalWindow.dataLayer || [];
                globalWindow.dataLayer.push({
                    event: "gtm.pageview",
                    pagePath: window.location.pathname,
                    pageTitle: document.title
                });

                // Trigger CallTrackingMetrics number swapping on dynamic transitions
                if (globalWindow.__ctm) {
                    if (globalWindow.__ctm.main && typeof globalWindow.__ctm.main.runNow === "function") {
                        globalWindow.__ctm.main.runNow();
                    } else if (typeof globalWindow.__ctm.run === "function") {
                        globalWindow.__ctm.run();
                    }
                }
            });
        </script>
        <script type="application/ld+json" is:inline>
        {
          "@context": "https://schema.org",
          "@type": "PoolService",
          "name": "Quality Pool and Spa",
          "url": "https://qualitypoolandspa.com",
          "logo": "https://qualitypoolandspa.com/favicon.svg",
          "image": "https://qualitypoolandspa.com/ogimage.png",
          "telephone": "+1-801-485-3221",
          "priceRange": "$$",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Salt Lake City",
            "addressRegion": "UT",
            "addressCountry": "US"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 40.7608,
            "longitude": -111.8910
          },
          "areaServed": [
            "Salt Lake City",
            "Sandy",
            "Draper",
            "South Jordan",
            "Murray",
            "Park City"
          ],
          "description": "Wasatch Front's premier choice for comprehensive pool and hot tub care, routine cleaning, water balancing, equipment repair, and winterization in Salt Lake City, Utah."
        }
        </script>
    </head>
    <body>
        <!-- Google Tag Manager (noscript) -->
        <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-58ZZ7XB2"
        height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
        <!-- End Google Tag Manager (noscript) -->
        <HomeHeader />
        <main>
            <slot />
        </main>
        <Footer />
        <MobileNav />
        <RequestForm />
        <svg xmlns="http://www.w3.org/2000/svg" class="hidden" aria-hidden="true">
            {svgSymbols.map((Symbol) => (
                <Symbol />
            ))}
        </svg>
        <script is:inline src="/js/scripts.js" defer></script>
        <script>
            import { functionFuzzyLoad } from "../assets/scripts/FuzzyLoad.js";
            
            // Prevent FOUT (Flash of Unstyled Text) Layout Shift Animations
            function initFonts() {
                Promise.all([
                    document.fonts.load("900 1em 'Roboto Condensed'"),
                    document.fonts.load("900 1em 'Raleway'"),
                ]).then(() => {
                    document.documentElement.classList.add('fonts-loaded');
                }).catch(() => {
                    document.documentElement.classList.add('fonts-loaded');
                });
            }

            // Defer heavy animations until after LCP
            function initCaustics() {
                if (document.readyState === 'complete') {
                    setTimeout(() => document.documentElement.classList.add('enable-caustics'), 100);
                } else {
                    window.addEventListener('load', () => {
                        setTimeout(() => document.documentElement.classList.add('enable-caustics'), 100);
                    });
                }
            }

            // Run on initial load and client-side routing transitions
            document.addEventListener("astro:page-load", () => {
                functionFuzzyLoad();
                initFonts();
                initCaustics();
            });
        </script>
    </body>
</html>
