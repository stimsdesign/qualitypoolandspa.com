---
import { siteConfig } from "../../siteConfig";

// Construct the full address from site configuration
const address = `${siteConfig.addressLine1}, ${siteConfig.city}, ${siteConfig.state} ${siteConfig.postalCode}`;

// Encode the address and brand name for the URL query
const encodedQuery = encodeURIComponent(`${siteConfig.brand}, ${address}`);

// Google Maps Embed URL (No API key required for basic embed)
// Using z=10 provides a regional zoom level that nicely encompasses the Wasatch Front
const mapUrl = `https://maps.google.com/maps?width=100%25&height=100%25&hl=en&q=${encodedQuery}&t=&z=10&ie=UTF8&iwloc=B&output=embed`;
---

<div class="google-map-container" id="google-map-wrapper">
    <iframe 
        src={mapUrl}
        data-src={mapUrl}
        width="100%" 
        height="100%" 
        style="border:0;" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="no-referrer-when-downgrade"
        title={`Google Map showing service area for ${siteConfig.brand}`}
        id="google-map-iframe"
    ></iframe>
</div>

<script>
    function initGoogleMap() {
        const wrapper = document.getElementById('google-map-wrapper');
        const iframe = document.getElementById('google-map-iframe') as HTMLIFrameElement | null;
        if (!iframe) return;

        if (window.innerWidth > 768) {
            if (wrapper) wrapper.style.display = '';
            const parent = wrapper?.closest('#service-area__map') as HTMLElement | null;
            if (parent) parent.style.display = '';

            const targetSrc = iframe.getAttribute('data-src') || iframe.src;
            if (targetSrc && (!iframe.src || iframe.src === 'about:blank' || iframe.src === window.location.href)) {
                iframe.src = targetSrc;
            }
        } else {
            if (wrapper) {
                wrapper.style.display = 'none';
                const parent = wrapper.closest('#service-area__map') as HTMLElement | null;
                if (parent) parent.style.display = 'none';
            }
        }
    }

    document.addEventListener("DOMContentLoaded", initGoogleMap);
    document.addEventListener("astro:page-load", initGoogleMap);
</script>

<style>
    .google-map-container {
        width: 100%;
        height: 100%;
        overflow: hidden;
        background-color: #e0e0e0;
        position: relative;
        z-index: 99; /* Ensure it stays above background elements */
    }

    @media (max-width: 769px) {
        .google-map-container {
            display: none;
        }
    }

    iframe {
        border: none;
        width: 100%;
        height: 100%;
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        background: transparent;
    }
</style>
